{
  "name": "night-shift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "howler": "^2.2.4",
    "pixi.js": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.nightshift.game",
    "productName": "NIGHT SHIFT",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
